--- a/Makefile
+++ b/Makefile
@@ -46,6 +46,12 @@ sql/$(EXTENSION)--$(EXTVERSION).sql: sql/$(EXTENSION).sql
 
 PG_CONFIG ?= pg_config
 PGXS := $(shell $(PG_CONFIG) --pgxs)
 include $(PGXS)
+
+# Termux build: Override PGXS installcheck to prevent QEMU linker64 errors
+# Android binaries cannot run in QEMU user-mode (missing /system/bin/linker64)
+installcheck:
+	@echo "Skipping installcheck (Termux cross-compilation)"
+
 
